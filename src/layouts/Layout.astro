---
export interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description ?? title} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <header>
      <nav>
        <a href="/" class="logo">我的博客</a>
        <div class="nav-links">
          <a href="/">首页</a>
          <a href="/blog">文章</a>
          <a href="/admin">管理</a>
        </div>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer>
      <p>&copy; {new Date().getFullYear()} 我的博客</p>
    </footer>
  </body>
</html>

<style>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }
  body {
    font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', sans-serif;
    line-height: 1.6;
    color: #1d1d1f;
    background: #fff;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
  }
  header {
    border-bottom: 1px solid #f2f2f2;
    padding: 0;
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255,255,255,0.85);
    backdrop-filter: saturate(180%) blur(20px);
  }
  nav {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 52px;
  }
  .logo {
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    color: #1d1d1f;
    letter-spacing: -0.01em;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
  }
  .nav-links a {
    text-decoration: none;
    color: #86868b;
    font-size: 0.875rem;
    font-weight: 400;
    transition: color 0.2s;
  }
  .nav-links a:hover {
    color: #1d1d1f;
  }
  main {
    flex: 1;
    max-width: 720px;
    margin: 0 auto;
    padding: 0 1.5rem;
    width: 100%;
  }
  footer {
    text-align: center;
    padding: 2.5rem 1.5rem 3rem;
    color: #86868b;
    font-size: 0.75rem;
  }
</style>
