function saveSettings() {
  const r = document.getElementById('set-repo').value.trim();
  const b = document.getElementById('set-branch').value.trim();
  const t = document.getElementById('set-token').value.trim();
  if (r) config.repo = r;
  if (b) config.branch = b;
  if (t) config.token = t;
  localStorage.setItem('blog-admin-config', JSON.stringify(config));
  showToast('✅ 设置已保存','success');
}

// ============ Media ============
function renderMedia() {
  const imgs = [];
  posts.forEach(p=>{
    if(p.body){
      const ms = p.body.match(/!\[.*?\]\((.*?)\)/g)||[];
      ms.forEach(m=>{const u=m.match(/\((.*?)\)/)[1];if(!u.startsWith('http'))imgs.push({url:u,post:p.title})});
    }
  });

  document.getElementById('page-content').innerHTML = `
    <h1 style="font-size:1.5rem;font-weight:700;margin-bottom:20px;color:#0f172a">🖼️ 媒体</h1>
    <div class="card">
      <h3 style="font-size:1rem;font-weight:600;margin-bottom:12px">文章中使用的本地图片</h3>
      ${imgs.length===0?'<p style="color:#94a3b8">暂未发现引用本地图片</p>':imgs.map(i=>`
        <div style="padding:8px 0;border-bottom:1px solid #f1f5f9;display:flex;justify-content:space-between;align-items:center">
          <code style="color:#3b82f6;font-size:0.9rem">${i.url}</code>
          <span style="font-size:0.8rem;color:#94a3b8">${i.post}</span>
        </div>
      `).join('')}
    </div>
    <div class="card">
      <h3 style="font-size:1rem;font-weight:600;margin-bottom:12px">上传图片到仓库</h3>
      <p style="color:#94a3b8;font-size:0.9rem">把图片放在 <code>public/</code> 目录中即可通过 <code>https://61306130.xyz/图片名</code> 访问。</p>
      <p style="color:#94a3b8;font-size:0.9rem">文章中用 <code>![alt](/图片名)</code> 引用。</p>
    </div>
  `;
}

// ============ Toast ============
function showToast(msg, type='info') {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.className = `toast toast-${type} show`;
  clearTimeout(el._timer);
  el._timer = setTimeout(()=>el.classList.remove('show'), 4000);
}
</script>
