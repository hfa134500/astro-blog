// ============ Posts ============
function renderPosts() {
  const list = [...posts];
  document.getElementById('page-content').innerHTML = `
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px">
      <h1 style="font-size:1.5rem;font-weight:700;color:#0f172a;margin:0">📄 文章管理</h1>
      <div style="display:flex;gap:8px">
        <button onclick="refreshAll()" class="btn btn-ghost btn-sm">🔄 刷新</button>
        <button onclick="newPost()" class="btn btn-primary">✏️ 新建文章</button>
      </div>
    </div>
    <div class="card" style="padding:16px">
      <div style="display:flex;gap:12px;align-items:center">
        <input type="text" id="search-input" placeholder="搜索文章标题..." style="max-width:320px" oninput="filterPosts(this.value)">
        <span style="font-size:0.85rem;color:#94a3b8">共 ${list.length} 篇</span>
      </div>
    </div>
    ${list.length===0?'<div class="card empty-state"><h3>📭 暂无文章</h3><p style="margin-bottom:16px">开始写第一篇吧！</p><button onclick="newPost()" class="btn btn-primary">✏️ 新建文章</button></div>':`
    <div class="card" style="padding:0;overflow:hidden">
      <table>
        <thead><tr><th style="width:38%">标题</th><th style="width:15%">日期</th><th style="width:25%">标签</th><th style="width:22%">操作</th></tr></thead>
        <tbody id="posts-tbody">
          ${list.map(p=>renderPostRow(p)).join('')}
        </tbody>
      </table>
    </div>`}
  `;
}

function renderPostRow(p) {
  return `<tr data-slug="${p.slug}">
    <td><div style="font-weight:500;color:#0f172a">${p.title}</div><div style="font-size:0.8rem;color:#94a3b8;margin-top:2px">${p.slug}.md</div></td>
    <td style="color:#64748b">${p.date||'-'}</td>
    <td>${(p.tags||[]).map(t=>'<span class="badge badge-blue" style="margin-right:4px">'+t+'</span>').join('')||'-'}</td>
    <td><button onclick="editPost('${p.slug}')" class="btn btn-ghost btn-sm" style="margin-right:6px">编辑</button><button onclick="deletePost('${p.slug}','${(p.title||'').replace(/'/g,"\\'")}')" class="btn btn-danger btn-sm">删除</button></td>
  </tr>`;
}

function filterPosts(q) {
  const f = q.toLowerCase();
  document.querySelectorAll('#posts-tbody tr').forEach(tr=>{
    tr.style.display = (f===''||tr.textContent.toLowerCase().includes(f))?'':'none';
  });
}

// ============ New / Edit ============
function newPost() {
  editingSlug = null;
  document.getElementById('editor-title').textContent = '✏️ 新建文章';
  document.getElementById('post-title').value = '';
  document.getElementById('post-desc').value = '';
  document.getElementById('post-date').value = new Date().toISOString().slice(0,10);
  document.getElementById('post-tags').value = '';
  document.getElementById('post-hero').value = '';
  document.getElementById('post-slug').value = '';
  document.getElementById('post-body').value = '';
  document.getElementById('editor-save-btn').textContent = '💾 保存并部署';
  document.getElementById('editor-modal').style.display = 'flex';
  setTimeout(()=>document.getElementById('post-title').focus(),100);
}

async function editPost(slug) {
  const p = posts.find(x=>x.slug===slug);
  if (!p) { showToast('文章不存在','error'); return; }
  editingSlug = slug;
  document.getElementById('editor-title').textContent = '📝 编辑文章';
  document.getElementById('post-title').value = p.title;
  document.getElementById('post-desc').value = p.desc;
  document.getElementById('post-date').value = (p.date||'').slice(0,10);
  document.getElementById('post-tags').value = (p.tags||[]).join(', ');
  document.getElementById('post-hero').value = p.hero||'';
  document.getElementById('post-slug').value = slug;
  document.getElementById('post-body').value = p.fm?._body||'';
  document.getElementById('editor-save-btn').textContent = '💾 保存并部署';
  document.getElementById('editor-modal').style.display = 'flex';
}

function closeEditor() { document.getElementById('editor-modal').style.display = 'none'; }

async function savePost() {
  const title = document.getElementById('post-title').value.trim();
  const description = document.getElementById('post-desc').value.trim();
  const pubDate = document.getElementById('post-date').value;
  const tagsRaw = document.getElementById('post-tags').value.trim();
  const heroImage = document.getElementById('post-hero').value.trim();
  const bodyRaw = document.getElementById('post-body').value.trim();
  const slugInput = document.getElementById('post-slug').value.trim();

  if (!title) { showToast('请填写文章标题','error'); return; }
  if (!description) { showToast('请填写文章描述','error'); return; }
  if (!pubDate) { showToast('请选择发布日期','error'); return; }
  if (!bodyRaw) { showToast('请填写文章正文','error'); return; }

  const tags = tagsRaw ? tagsRaw.split(',').map(t=>t.trim()).filter(Boolean) : [];
  const slug = slugInput || title.toLowerCase().replace(/[^a-z0-9\u4e00-\u9fa5]+/g,'-').replace(/^-+|-+$/g,'')||'post';
  const isNew = !editingSlug;
  
  let md = buildFrontmatter({title,description,pubDate,tags,heroImage});
  md += bodyRaw + '\n';
  const path = `src/content/blog/${slug}.md`;
  const msg = isNew ? `feat: new post "${title}"` : `update: ${title}`;

  const btn = document.getElementById('editor-save-btn');
  btn.disabled = true; btn.textContent = '⏳ 保存中...';

  try {
    await ghWriteFile(path, md, msg);
    closeEditor();
    await refreshPosts();
    nav('posts');
    triggerDeploy('save');
  } catch (e) {
    showToast(`保存失败: ${e.message}`,'error');
    btn.disabled = false; btn.textContent = '💾 保存并部署';
  }
}

// ============ Delete ============
function deletePost(slug, title) {
  deletingSlug = slug;
  document.getElementById('delete-title-text').textContent = title;
  document.getElementById('delete-modal').style.display = 'flex';
}
function closeDelete() { document.getElementById('delete-modal').style.display = 'none'; deletingSlug=null; }

async function confirmDelete() {
  if (!deletingSlug) return;
  const btn = document.getElementById('delete-confirm-btn');
  btn.disabled = true; btn.textContent = '⏳ 删除中...';
  try {
    await ghDeleteFile(`src/content/blog/${deletingSlug}.md`,`delete: ${deletingSlug}`);
    closeDelete();
    await refreshPosts();
    nav('posts');
    triggerDeploy('delete');
  } catch(e) { showToast(`删除失败: ${e.message}`,'error'); }
  btn.disabled = false; btn.textContent = '🗑️ 确认删除';
}

// ============ Refresh All ============
async function refreshAll() {
  const btn = event?.target || document.querySelector('[onclick*="refreshAll"]');
  if (btn) { btn.disabled = true; btn.textContent = '⏳...'; }
  try {
    await refreshPosts();
    nav('posts');
    showToast('✅ 已刷新','success');
  } catch(e) { showToast(`刷新失败: ${e.message}`,'error'); }
  if (btn) { btn.disabled = false; btn.textContent = '🔄 刷新'; }
}

// ============ Deploy Hook ============
const DEPLOY_STEPS = [
  { id: 'step-1', label: '📝 提交' },
  { id: 'step-2', label: '⬆️ 推送' },
  { id: 'step-3', label: '🔄 部署' },
  { id: 'step-4', label: '✅ 完成' },
];

function showDeployOverlay(title, msg, step) {
  document.getElementById('deploy-overlay').style.display = 'flex';
  document.getElementById('deploy-icon').textContent = ['⏳','⏳','🔄','✅'][step-1] || '⏳';
  document.getElementById('deploy-status-title').textContent = title;
  document.getElementById('deploy-status-msg').textContent = msg;
  document.getElementById('deploy-result').style.display = 'none';
  
  DEPLOY_STEPS.forEach((s, i) => {
    const el = document.getElementById('deploy-' + s.id);
    if (i < step) {
      el.className = 'badge badge-green';
      el.textContent = '✅ ' + s.label.slice(2);
    } else if (i === step) {
      el.className = 'badge badge-blue';
    } else {
      el.className = 'badge badge-gray';
    }
  });
}

function showDeployResult(success, deployUrl) {
  document.getElementById('deploy-icon').textContent = success ? '✅' : '❌';
  document.getElementById('deploy-status-title').textContent = success ? '部署完成！' : '部署失败';
  document.getElementById('deploy-status-msg').textContent = success 
    ? '博客已更新到最新内容，可以查看。' 
    : '部署遇到问题，请稍后重试。';
  document.getElementById('deploy-result').style.display = 'block';
  document.getElementById('deploy-check-url').innerHTML = success 
    ? `🔗 <a href="${deployUrl}" target="_blank" style="color:#3b82f6">查看部署详情</a>`
    : '';
  DEPLOY_STEPS.forEach(s => {
    document.getElementById('deploy-' + s.id).className = success ? 'badge badge-green' : 'badge badge-gray';
  });
}

async function triggerDeploy(source) {
  showDeployOverlay('正在部署...', '已提交到 GitHub，正在触发 Vercel 部署...', 3);
  
  // Call Vercel deploy hook to trigger a rebuild
  try {
    const res = await fetch(DEPLOY_HOOK_URL, { method: 'POST' });
    if (res.ok || res.status === 201) {
      const data = await res.json().catch(() => ({}));
      const deployUrl = data.url || data.alias?.[0]?.domain 
        ? `https://${data.alias[0].domain}` 
        : 'https://61306130.xyz';
      
      showDeployOverlay('部署中...', 'Vercel 正在构建和部署...', 4);
      
      // Poll for deployment status
      let attempts = 0;
      const poll = setInterval(async () => {
        attempts++;
        try {
          const check = await fetch('https://61306130.xyz', { method: 'HEAD' });
          if (check.ok) {
            clearInterval(poll);
            showDeployResult(true, deployUrl);
          } else if (attempts > 30) {
            clearInterval(poll);
            showDeployResult(true, deployUrl); // Assume success after timeout
          }
        } catch(e) {
          if (attempts > 30) {
            clearInterval(poll);
            showDeployResult(true, deployUrl);
          }
        }
      }, 3000);
    } else {
      // Deploy hook failed but commit was made - Vercel will auto-deploy from GitHub
      showDeployOverlay('已提交', 'GitHub 已更新，Vercel 自动部署中...', 4);
      setTimeout(() => showDeployResult(true, 'https://61306130.xyz'), 2000);
    }
  } catch (e) {
    // Hook call failed but commit was made
    showDeployOverlay('已提交', 'GitHub 已更新，Vercel 自动部署中...', 4);
    setTimeout(() => showDeployResult(true, 'https://61306130.xyz'), 2000);
  }
}

function checkDeployResult() {
  window.open('https://vercel.com/jack6130s-projects/astro-blog-6130', '_blank');
}

