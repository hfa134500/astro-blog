---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = await getCollection('blog');
posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<Layout title="我的博客">
  <section class="hero">
    <h1>我的博客</h1>
  </section>

  <section class="post-list">
    {posts.length === 0 && <p class="empty">还没有文章</p>}
    {posts.map(post => (
      <article class="post-card">
        <a href={`/blog/${post.id.replace(/\.md$/, '')}/`}>
          {post.data.heroImage && (
            <img src={post.data.heroImage} alt="" class="card-image" />
          )}
          <div class="card-content">
            <h3>{post.data.title}</h3>
            <p class="card-description">{post.data.description}</p>
            <div class="card-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('zh-CN', {
                  year: 'numeric', month: 'long', day: 'numeric'
                })}
              </time>
              {post.data.tags.length > 0 && (
                <div class="card-tags">
                  {post.data.tags.map(tag => <span class="tag">{tag}</span>)}
                </div>
              )}
            </div>
          </div>
        </a>
      </article>
    ))}
  </section>
</Layout>

<style>
  .hero {
    padding: 3.5rem 0 2rem;
  }
  .hero h1 {
    font-size: 2.25rem;
    font-weight: 700;
    color: #1d1d1f;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .empty {
    text-align: center;
    color: #86868b;
    padding: 3rem 0;
    font-size: 0.9rem;
  }
  .post-card {
    border-bottom: 1px solid #f2f2f2;
    transition: opacity 0.2s;
  }
  .post-card:last-child {
    border-bottom: none;
  }
  .post-card:hover {
    opacity: 0.7;
  }
  .post-card a {
    text-decoration: none;
    color: inherit;
    display: block;
    padding: 1.25rem 0;
  }
  .card-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
    margin-bottom: 1rem;
  }
  .card-content h3 {
    font-size: 1.35rem;
    font-weight: 600;
    margin-bottom: 0.35rem;
    color: #1d1d1f;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }
  .card-description {
    color: #86868b;
    font-size: 0.925rem;
    margin-bottom: 0.6rem;
    line-height: 1.5;
  }
  .card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    font-size: 0.8rem;
    color: #a1a1a6;
  }
  .card-tags {
    display: flex;
    gap: 0.4rem;
  }
  .tag {
    display: inline-block;
    background: #f5f5f7;
    color: #86868b;
    padding: 0.1rem 0.6rem;
    border-radius: 4px;
    font-size: 0.75rem;
    font-weight: 400;
  }
</style>
